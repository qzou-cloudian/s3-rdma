    High-level Python wrapper around the Rust ``RdmaProvider`` trait.

    Build with::

        maturin develop --release

    Then use::

        import s3_rdma
        provider = s3_rdma.CuObjProvider()          # or MockRdmaProvider()
        token = provider.prepare_put_token(buf, offset, size)
        # ... attach token as x-amz-rdma-token header in S3 PUT request ...
        provider.process_reply_token(reply_bytes, callback)
    """

    def name(self) -> str:
        ...

    def version(self) -> str:
        ...

    def is_memory_suitable(self, ptr: int, size: int) -> bool:
        ...

    def register_memory(self, ptr: int, size: int) -> None:
        ...

    def deregister_memory(self, ptr: int) -> None:
        ...

    def prepare_put_token(self, buf: bytes, offset: int, size: int) -> bytes:
        ...

    def prepare_get_token(self, buf: bytes, offset: int, size: int) -> bytes:
        ...

    def process_reply_token(self, reply: bytes, callback) -> None:
        ...


class MockRdmaProvider(RdmaProvider):
    """Mock provider — no NVIDIA hardware required."""

    def __init__(self, debug: bool = False) -> None:
        ...


class CuObjProvider(RdmaProvider):
    """
    Real cuObject RDMA provider.

    Loads ``libs3_rdma_cuobj.so`` at runtime via ``dlopen``.
    Requires an RDMA-capable NIC and NVIDIA cuObject SDK.
    """

